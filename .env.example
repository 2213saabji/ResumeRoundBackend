# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---- MongoDB Atlas ----
# Use the SRV form (survives Atlas changing servers) and always include the database name in the
# path, otherwise the driver silently uses a database called "test".
# Local development should use its own database (e.g. resumerounddev), not resumeroundprod.
# If your network's DNS refuses SRV lookups (error: querySrv ECONNREFUSED), switch your DNS to
# 8.8.8.8 / 1.1.1.1, or use the standard "mongodb://host1,host2,host3/..." string from
# Atlas -> Connect -> Drivers.
MONGODB_URI=mongodb+srv://resumeround_db_user:<db_password>@resumeroundcluster.wcpxfza.mongodb.net/resumerounddev?retryWrites=true&w=majority&appName=ResumeRoundCluster

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 'none' when the frontend (Vercel) and API are on different sites; requires COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=

# ---- Object storage ----
# 'local' writes to LOCAL_STORAGE_DIR (dev only); 's3' uses any S3-compatible store
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- AI gateway ----
# 'mock' needs no key (deterministic heuristics, for local dev and tests); 'anthropic' calls Claude;
# 'ollama' calls open models on an Ollama server (see the Ollama block below)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_SMALL=claude-haiku-4-5
AI_MODEL_MID=claude-sonnet-5-5
AI_MODEL_LARGE=claude-opus-5-5
AI_INTERVIEW_COST_TARGET_USD=0.75

# ---- Ollama (AI_PROVIDER=ollama) ----
# Local: install from ollama.com, then `ollama pull qwen2.5:3b`. Production: a private GPU server
# (never expose port 11434 to the internet; Ollama has no authentication).
OLLAMA_URL=http://127.0.0.1:11434
# Only for Ollama Cloud (OLLAMA_URL=https://ollama.com); create one at ollama.com/settings/keys
OLLAMA_API_KEY=
# One model for every task, or override per tier (small: each question; mid: resume and answer
# scoring; large: the final report)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL_SMALL=
OLLAMA_MODEL_MID=
OLLAMA_MODEL_LARGE=
# Context window (tokens); the Ollama default cuts long resumes and reports
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=120000

# ---- Speech (MVP-4 voice) ----
# 'mock' needs no key (fake transcripts, silent audio). Try real providers with
# `npx tsx src/scripts/speech-probe.ts` before switching.
# One Deepgram key (console.deepgram.com -> API Keys, role "Default"; $200 free credit) covers
# both speech-to-text and Deepgram text-to-speech.
DEEPGRAM_API_KEY=
STT_PROVIDER=mock
STT_MODEL=nova-3
# 'en', 'en-IN', or 'multi' for candidates who mix English and Hindi
STT_LANGUAGE=en
# Silence (ms) that ends a segment; gap (ms, min 1000) that ends an utterance
STT_ENDPOINTING_MS=500
STT_UTTERANCE_END_MS=1000
# Text-to-speech: 'deepgram' (Aura-2, same key as STT) or 'google' (Chirp 3 HD; needs an API key
# restricted to the "Cloud Text-to-Speech API").
TTS_PROVIDER=mock
GOOGLE_TTS_API_KEY=
# Empty = provider default (deepgram: aura-2-thalia-en, google: en-IN-Chirp3-HD-Kore).
# List voices with: npx tsx src/scripts/speech-probe.ts voices
TTS_VOICE=
# Google only
TTS_SPEAKING_RATE=1

# ---- Quotas ----
FREE_INTERVIEWS_PER_MONTH=5

# ---- Jobs / bot ----
JOB_POLL_MIN_MS=500
JOB_POLL_MAX_MS=10000
JOB_CONCURRENCY=4
BOT_HEARTBEAT_MS=5000
BOT_CAPACITY=25
# Voice turn-taking: extra silence (ms) after the last word before an answer is submitted, and
# a longer wait for short answers ("let me think") so candidates can pause to think
BOT_POLL_MS=1000
BOT_TURN_END_MS=300
BOT_SHORT_ANSWER_WAIT_MS=6000
BOT_MIN_ANSWER_WORDS=4

# ---- Janus + TURN (MVP-4) ----
# Dev server: see infra/dev-server/README.md. Copy the secrets from /etc/resumeround/secrets.env
# on the server (sudo cat). Leave JANUS_HTTP_URL empty to run without Janus.
# JANUS_HTTP_URL=http://<server-ip>:8088/janus
# JANUS_WS_URL=ws://<server-ip>:8188
JANUS_HTTP_URL=
JANUS_WS_URL=
# Signs short-lived Janus tokens (backend, bot and browsers). Required when JANUS_HTTP_URL is set.
JANUS_TOKEN_SECRET=
# Admin/monitoring API, only reachable through an SSH tunnel.
JANUS_ADMIN_SECRET=
# Creating rooms and forwarding RTP.
AUDIOBRIDGE_ADMIN_KEY=
TEXTROOM_ADMIN_KEY=
# Comma-separated, e.g. stun:<server-ip>:3478,turn:<server-ip>:3478?transport=udp
TURN_URLS=
TURN_SECRET=
TURN_REALM=resumeround.dev

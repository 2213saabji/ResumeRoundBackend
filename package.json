{
  "name": "resumeround-backend",
  "version": "0.1.0",
  "description": "AI Resume-Based Interview Simulator - backend (API, interview bot, job workers)",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c cyan,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/apps/api.ts",
    "dev:worker": "tsx watch src/apps/worker.ts",
    "dev:bot": "tsx watch src/apps/bot.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/apps/api.js",
    "start:worker": "node dist/apps/worker.js",
    "start:bot": "node dist/apps/bot.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:sync-indexes": "tsx src/scripts/sync-indexes.ts"
  },
  "author": "Gurpreet Singh",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "mammoth": "^1.13.0",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "opusscript": "^0.1.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "werift": "^0.25.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
